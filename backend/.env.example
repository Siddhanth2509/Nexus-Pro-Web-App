# Backend Environment Variables Template
# Copy this file to .env and fill in the actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# For local development with SQLite (file-based), leave empty or use 'sqlite'
# For PostgreSQL production: postgresql://user:password@host:port/database
DATABASE_URL=

# Authentication - Generate random 32+ character strings
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_32_chars_minimum
JWT_REFRESH_SECRET=your_refresh_secret_key_here_32_chars_minimum

# Google OAuth
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=

# Optional
# LOG_LEVEL=debug
# CORS_ORIGIN=*
